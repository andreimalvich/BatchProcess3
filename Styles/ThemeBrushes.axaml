<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->


    <!-- ==================== -->
    <!--   Color Resources    -->
    <!-- ==================== -->

    <!-- Primary Colors -->
    <Color x:Key="PrimaryBackgroundColor1">#111214</Color>
    <Color x:Key="PrimaryBackgroundColor2">#151E3E</Color>



    <!-- Existing Gradient Stop Colors -->
    <Color x:Key="DefaultGradientStopColor">#333B5A</Color>

    <!-- ============================== -->
    <!--   SolidColorBrush Resources    -->
    <!-- ============================== -->

    <!-- Primary Brushes -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="PrimaryBackground" Color="#14172D"/>

    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#333B5A" />
    <SolidColorBrush x:Key="PrimaryActiveBackground" Color="#6633dd" />
    <SolidColorBrush x:Key="PrimaryHoverForeground" Color="White"/>

    <!-- ================================ -->
    <!--   LinearGradientBrush Resources  -->
    <!-- ================================ -->

    <LinearGradientBrush x:Key="PrimaryBackgroundGradient" StartPoint="0%, 0%" EndPoint="100%, 0%">
        <GradientStop Offset="0" Color="{DynamicResource PrimaryBackgroundColor1}"/>
        <GradientStop Offset="1" Color="{DynamicResource PrimaryBackgroundColor2}"/>
    </LinearGradientBrush>




</ResourceDictionary>
